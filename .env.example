# Kredensial email (opsional).
# Tanpa variabel ini, formulir kontak tetap bisa dicoba dalam mode demo:
# pesan divalidasi tetapi tidak dikirim ke email mana pun.

# API key dari https://resend.com/api-keys
RESEND_API_KEY=

# Email tujuan tempat pesan masuk.
CONTACT_TO_EMAIL=aryasirega23@gmail.com

# Pengirim yang sudah diverifikasi di Resend, contoh:
# CONTACT_FROM_EMAIL="Portofolio Arya <halo@domainkamu.com>"
CONTACT_FROM_EMAIL=
